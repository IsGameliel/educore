# Copy to ~/.config/euvion/deploy.env on HOSTING only. chmod 600.
# No passwords or migration credentials belong here.
APP_ROOT="$HOME/euvion"
PHP_BIN=/opt/cpanel/ea-php83/root/usr/bin/php
# Use the actual executable on this host. Composer must use matching PHP.
COMPOSER_BIN=/usr/local/bin/composer
NPM_BIN=npm
