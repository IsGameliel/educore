APP_NAME=Euvion
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://euvion.com.ng
PLATFORM_URL=https://euvion.com.ng
TENANCY_ENABLED=true
TENANCY_LEGACY_HOSTS=
CENTRAL_DOMAINS=euvion.com.ng,www.euvion.com.ng
# Reserved platform namespace; signup requires a school-owned hostname.
INSTITUTION_BASE_DOMAIN=euvion.com.ng

# Separate, freshly created support database. Never reuse the shared database here.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANELUSER_euvion_support
DB_USERNAME=CPANELUSER_runtime
DB_PASSWORD="REPLACE_RUNTIME_PASSWORD"
CENTRAL_DB_HOST=localhost
CENTRAL_DB_PORT=3306
CENTRAL_DB_DATABASE=CPANELUSER_euvion_shared
CENTRAL_DB_USERNAME=CPANELUSER_runtime
CENTRAL_DB_PASSWORD="REPLACE_RUNTIME_PASSWORD"

SESSION_DRIVER=database
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=central
DB_QUEUE_RETRY_AFTER=180
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=warning

MAIL_MAILER=smtp
MAIL_HOST=REPLACE_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_SMTP_USERNAME
MAIL_PASSWORD="REPLACE_SMTP_PASSWORD"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notifications@euvion.com.ng
MAIL_FROM_NAME=Euvion
# Use a Paystack TEST secret for the online test; never commit it.
PLATFORM_PAYSTACK_SECRET_KEY=
# Do not put migration or owner passwords in this file. Supply them to the CLI only.

# Automatic dedicated databases for new paid institutions (enable after API verification).
DIRECTADMIN_DATABASES_ENABLED=false
DIRECTADMIN_URL=
DIRECTADMIN_USERNAME=
DIRECTADMIN_LOGIN_KEY=
