APP_NAME=Euvion
# PLATFORM_URL=http://educore.test:8000
PLATFORM_URL=https://euvion.com.ng
INSTITUTION_BASE_DOMAIN=euvion.com.ng
# Platform subscription payments use a separate key from school/student payments.
PLATFORM_PAYSTACK_SECRET_KEY=
PAYSTACK_SECRET_KEY=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=euvion_reload
DB_USERNAME=root
DB_PASSWORD=
DB_BACKUP_BINARY=mysqldump
DB_BACKUP_RETENTION_DAYS=120

# Shared multi-tenant development database. Leave DB_DATABASE unchanged until cutover.
CENTRAL_DB_DATABASE=educore_shared
# Dedicated operator credentials; keep out of the web runtime environment in production.
TENANCY_MIGRATION_USERNAME=
TENANCY_MIGRATION_PASSWORD=
CENTRAL_DOMAINS=educore.test
TENANCY_ENABLED=true
# Local/testing legacy hosts default to localhost,127.0.0.1; production defaults to none.
# TENANCY_LEGACY_HOSTS=
# CENTRAL_DB_HOST/PORT/USERNAME/PASSWORD default to the existing DB_* values.
# All institutions share CENTRAL_DB_DATABASE; no database is created per institution.
# Initial passwords are prompted or read from PLATFORM_ADMIN_PASSWORD / TENANT_ADMIN_PASSWORD.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
TUITION_EMAIL_REMINDERS=true

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Euvion"


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

QUEUE_CONNECTION=database

# Automatic dedicated databases for new paid institutions (enable after API verification).
DIRECTADMIN_DATABASES_ENABLED=false
DIRECTADMIN_URL=
DIRECTADMIN_USERNAME=
DIRECTADMIN_LOGIN_KEY=
